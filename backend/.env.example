EMS_EXECUTION_MODE=simulated
# full preserves the existing EMS; connectivity exposes only Ubuntu/SSH readiness.
EMS_DEPLOYMENT_STAGE=full
EMS_DEPLOYED_SCENARIOS=["4g-epc"]
# Defaults for native Windows backend: keys outside the repository under
# ~/VirtualBox VMs/MAEstro-4G/{id_rsa,known_hosts}.
EMS_VM_SSH_HOST=127.0.0.1
EMS_VM_SSH_USER=emsadmin
EMS_SECRET_KEY=replace-with-a-long-random-value

# VirtualBox NAT: host 127.0.0.1:2222 -> guest:22
EMS_TESTBED_HOST=127.0.0.1
EMS_SSH_PORT=2222
EMS_SSH_USER=emsadmin
EMS_SSH_PASSWORD=
EMS_SSH_STRICT_HOST_KEY=false

EMS_ENABLE_REAL_CAPTURES=false
EMS_METRICS_COLLECTION_INTERVAL_SECONDS=10
EMS_METRICS_RETENTION_DAYS=30
EMS_OPEN5GS_INFO_PORT=9090
EMS_OPERATION_OUTPUT_LIMIT=100000
EMS_ALLOWED_INTERFACES=["lo","ogstun","enp0s3","any"]
EMS_ENABLE_MONGO=false
